# Auth0, tenant better-net.eu.auth0.com. Copy to .env.local (gitignored).
# The real values are written by the Auth0 MCP onboarding tool; none of these are secrets
# (a SPA client id is public — the client is a public client with no secret).

VITE_AUTH0_DOMAIN=better-net.eu.auth0.com
VITE_AUTH0_CLIENT_ID=WBF8SVYqzsxI37AbH733VNHyQgvPs5ou

# The bn-server API's identifier, and the one setting that is easy to get wrong: without it
# Auth0 issues an opaque access token rather than a JWT, so sign-in appears to work and then
# every API call is a 401. Must match bn-server's AUTH0_AUDIENCE.
# Needs the "BetterNet Server API" resource server in the tenant (it exists); if it is ever
# removed, asking for this audience fails the login outright with "Service not found".
VITE_AUTH0_AUDIENCE=https://server.better-net.com/api
