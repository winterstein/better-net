{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "types": ["chrome", "node"]
  },
  "include": [
    "src/server.ts",
    "src/db.ts",
    "src/SearchQuery.ts",
    "src/routes/**/*",
    "src/utils/**/*",
    "src/ai/**/*",
    "src/bn-extension-src/analysis/**/*",
    "src/bn-extension-src/analyzers/**/*",
    "src/bn-extension-src/features/**/*",
    "src/bn-extension-src/types/**/*",
    "src/bn-extension-src/ai/**/*",
    "src/bn-extension-src/prompts/**/*",
    "src/bn-extension-src/utils/hash.ts",
    "src/bn-extension-src/utils/logger.ts",
    "src/bn-extension-src/utils/env-utils.ts",
    "src/bn-extension-src/env.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "src/bn-extension-src/ai/local-model-offscreen.ts",
    "src/bn-extension-src/ai/local-inference-client.ts"
  ]
}

