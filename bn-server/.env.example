# Optional: POST LLM trace events for observability (AIQA)
# BN_AIQA_ENDPOINT=https://aiqa.winterwell.com/api/traces

# LLM API keys (server analysis defaults to heuristic when unset)
# BN_OPENAI_API_KEY=
# BN_ANTHROPIC_API_KEY=
# BN_GOOGLE_API_KEY=

# postgresql
# DB host, user, password, etc for Postgres
DB_HOST=
DB_PORT=5432
DB_NAME=neondb
# DB_NAME=betternet
DB_USERNAME=neondb_owner
DB_PASSWORD=
DB_URL=

# Server port and host
SERVER_PORT=4101
SERVER_HOST=0.0.0.0

# Service run user (default: current user or 'bn' on prod hosts)
# RUN_AS_USER=bn

# Auth0 (tenant better-net.eu.auth0.com). Must match bn-webapp's VITE_AUTH0_AUDIENCE, or
# the JWT the webapp sends is rejected and every guarded route 401s.
AUTH0_DOMAIN=better-net.eu.auth0.com
AUTH0_AUDIENCE=https://server.better-net.com/api

# Keys the staff view's submitter pseudonyms. Local dev value; production needs its own.
BN_PSEUDONYM_SECRET=
