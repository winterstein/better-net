# Optional: POST LLM trace events for observability (AIQA)
# BN_AIQA_ENDPOINT=https://aiqa.winterwell.com/api/traces

# LLM API keys (server analysis defaults to heuristic when unset)
# BN_OPENAI_API_KEY=
# BN_ANTHROPIC_API_KEY=
# BN_GOOGLE_API_KEY=

# postgresql
# Hostname only — the database name goes in DB_NAME (Neon's default DB is often neondb)
DB_HOST=
DB_PORT=5432
DB_NAME=neondb
# DB_NAME=betternet
DB_USERNAME=neondb_owner
DB_PASSWORD=
# Not read by the server: src/db.ts builds its connection from the discrete DB_* vars
# above, so setting only DB_URL connects to nothing. Kept because psql and Neon's console
# hand you a URL, and it is useful to keep the two side by side.
DB_URL=

# Server port and host. Note src/server.ts reads PORT and HOST; the deploy workflow
# translates SERVER_PORT/SERVER_HOST into those when it writes the host's .env.
SERVER_PORT=4101
SERVER_HOST=0.0.0.0

# Service run user (default: current user or 'bn' on prod hosts)
# RUN_AS_USER=bn

# Auth0 (tenant better-net.eu.auth0.com). Reading or deleting feedback needs a JWT; writing
# it stays anonymous. AUTH0_AUDIENCE must match bn-webapp's VITE_AUTH0_AUDIENCE, or the JWT
# the webapp sends is rejected. Without AUTH0_DOMAIN the guarded routes all 401 rather than
# accepting unverified tokens (src/auth.ts) — silence, not a warning, so check it first when
# a valid-looking token gets a 401.
AUTH0_DOMAIN=better-net.eu.auth0.com
AUTH0_AUDIENCE=https://server.better-net.com/api

# Keys the staff feedback view's submitter pseudonyms. Set this before real traffic: an empty
# secret makes the pseudonyms reversible by hashing candidate local ids. Changing it later
# re-pseudonymises everyone, so set it once and leave it alone.
BN_PSEUDONYM_SECRET=
