# Optional: POST LLM trace events for observability (AIQA)
# BN_AIQA_ENDPOINT=https://aiqa.winterwell.com/api/traces

# LLM API keys (server analysis defaults to heuristic when unset)
# BN_OPENAI_API_KEY=
# BN_ANTHROPIC_API_KEY=
# BN_GOOGLE_API_KEY=

# postgresql
# DB host, user, password, etc for Postgres
# Hostname only — database name goes in DB_NAME (Neon default DB is often neondb)
DB_HOST=ep-quiet-block-a97vg65v-pooler.gwc.azure.neon.tech
DB_PORT=5432
DB_NAME=betternet
DB_USERNAME=neondb_owner
DB_PASSWORD=

# Server port and host
SERVER_PORT=4101
SERVER_HOST=0.0.0.0

# Service run user (default: current user or 'bn' on prod hosts)
# RUN_AS_USER=bn

# Auth0 (tenant better-net.eu.auth0.com). Reading or deleting feedback needs a JWT;
# writing it stays anonymous. Without AUTH0_DOMAIN the guarded routes all 401 rather
# than accepting unverified tokens (src/auth.ts).
AUTH0_DOMAIN=better-net.eu.auth0.com
AUTH0_AUDIENCE=https://server.better-net.com/api

# Keys the staff feedback view's submitter pseudonyms. Set this before real traffic:
# an empty secret makes the pseudonyms reversible by hashing candidate local ids.
BN_PSEUDONYM_SECRET=
